# ============================================================
#  Copy to .env and change every password before first run
#  cp .env.example .env
# ============================================================

# ── MySQL ────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=ChangeMeRoot!
MYSQL_PASSWORD=ChangeMeMySQL!

# ── MISP ─────────────────────────────────────────────────────
MISP_ADMIN_EMAIL=admin@ot-lab.local
MISP_ADMIN_PASSPHRASE=ChangeMeMISP!
MISP_ORG=OT-ICS-Lab
MISP_PORT=8080
# Leave blank — auto-generated on first start
MISP_UUID=

# ── Shuffle ───────────────────────────────────────────────────
SHUFFLE_ADMIN_EMAIL=admin@shuffle.local
SHUFFLE_ADMIN_PASSWORD=ChangeMeShuffle!
# Leave blank to have Shuffle generate one, or set a fixed key
# for scripted imports (init-lab.sh uses this)
SHUFFLE_DEFAULT_APIKEY=
SHUFFLE_PORT=3001